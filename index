<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Henry">
<meta name="theme-color" content="#E9E3D6">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<title>175 → 160 · Henry</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#E9E3D6;
    --deck:#F8F4EB;
    --deck-2:#EFE9DB;
    --edge:#D9D0BD;
    --flare:#9A5B37;
    --volt:#6E5A3E;
    --steel:#7A7062;
    --dim:#A79C87;
    --paper:#3E382E;
    --teal:#6E5A3E;
    --peach:#C98A5A;
    /* elevation system (light): flat-ish surfaces + soft warm shadows */
    --grad-card:linear-gradient(180deg,#FAF6EE,#F5F0E5);
    --grad-tile:linear-gradient(180deg,#F1EBDD,#EAE3D3);
    --shadow-card:0 20px 44px -22px rgba(110,90,60,.26), 0 4px 12px -6px rgba(110,90,60,.12);
    --shadow-tile:0 8px 20px -10px rgba(110,90,60,.15);
    --shadow-pop:0 10px 24px -8px rgba(110,90,60,.2);
    --hi:inset 0 1px 0 rgba(255,255,255,.6);
    --inset:inset 0 1px 2px rgba(110,90,60,.1);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}
  body{
    background:#E9E3D6;color:var(--paper);
    font-family:'Jost',system-ui,sans-serif;line-height:1.5;
    max-width:600px;margin:0 auto;padding:env(safe-area-inset-top) 0 calc(60px + env(safe-area-inset-bottom));min-height:100vh;overflow-x:hidden;
    background-image:radial-gradient(120% 55% at 50% 0%, rgba(154,91,55,0.12), transparent 58%), radial-gradient(90% 60% at 50% 100%, rgba(20,42,72,0.6), transparent 70%);
    background-attachment:fixed;
  }
  .wrap{padding:0 16px;}
  .serif{font-family:'Jost',sans-serif;font-weight:300;}
  .mono{font-family:'Jost',monospace;}

  /* HERO */
  .hero{padding:26px 0 18px;text-align:center;}
  .hero .lede{font-family:'Jost',monospace;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(--flare);}
  .hero h1{font-family:'Jost',serif;font-size:46px;line-height:1;margin:12px 0 6px;letter-spacing:-0.01em;}
  .hero h1 em{font-style:italic;color:var(--flare);}
  .hero .note{color:var(--steel);font-size:13.5px;max-width:38ch;margin:0 auto;}

  /* TABS */
  .tabs{display:flex;gap:6px;margin:20px 0 4px;background:#F5E8EB;padding:5px;border-radius:14px;border:1px solid rgba(47,86,140,.5);box-shadow:var(--inset);}
  .tab{flex:1;text-align:center;padding:10px 4px;border-radius:10px;cursor:pointer;font-family:'Jost',monospace;
    font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim);transition:.15s;border:none;background:none;}
  .tab.on{background:#E7DDC7;color:var(--volt);font-weight:600;box-shadow:none;}
  .tab:focus-visible{outline:2px solid var(--volt);outline-offset:2px;}
  .panel{display:none;}
  .panel.on{display:block;}
  #panels.sliding{position:relative;overflow:hidden;}
  #panels.sliding .panel{position:absolute;top:0;left:0;width:100%;}
  #panels.sliding .panel.on{z-index:2;}
  #panels.sliding .panel.leaving{display:block;z-index:1;}

  /* launch splash */
  #splash{position:fixed;inset:0;z-index:200;background:#E9E3D6;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;animation:splashOut .5s ease .95s forwards;}
  #splash .sp-inner{display:flex;flex-direction:column;align-items:center;gap:14px;animation:spIn .5s ease both;}
  #splash .sp-word{font-family:'Jost',serif;font-size:36px;color:var(--paper);letter-spacing:-.01em;}
  #splash .sp-word em{font-style:italic;color:var(--flare);}
  #splash .sp-path{stroke-dasharray:130;stroke-dashoffset:130;animation:draw .7s cubic-bezier(.4,0,.2,1) .15s forwards;}
  @keyframes splashOut{to{opacity:0;visibility:hidden;}}
  @keyframes spIn{from{opacity:0;transform:translateY(8px) scale(.96);}to{opacity:1;transform:none;}}
  @keyframes draw{to{stroke-dashoffset:0;}}
  @media (prefers-reduced-motion:reduce){#splash{animation:none;opacity:0;visibility:hidden;} #splash .sp-inner,#splash .sp-path{animation:none;}}

  /* open-time nudge banner */
  .nudge{display:flex;align-items:center;gap:10px;margin:10px 0 0;padding:11px 14px;border-radius:13px;
    background:linear-gradient(168deg, rgba(154,91,55,.16), rgba(154,91,55,.05));
    border:1px solid rgba(154,91,55,.32);box-shadow:var(--shadow-tile), var(--hi);font-size:13px;color:var(--paper);
    animation:spIn .35s ease both;}
  .nudge #nudgeText{flex:1;line-height:1.4;}
  .nudge #nudgeText b{color:var(--volt);font-weight:700;}
  .nudge button{background:none;border:1px solid transparent;color:var(--dim);cursor:pointer;font-size:14px;padding:2px 6px;flex-shrink:0;border-radius:8px;}
  .nudge button:hover{color:var(--flare);}

  /* snappier press feedback on tappable things */
  .day,.tab,.cell{transition:transform .1s ease, background .15s, border-color .15s;}
  .day:active,.tab:active{transform:scale(.97);}
  .cell:active{transform:scale(.88);}
  .logbtn:active,.bkbtn:active,.wrow button:active,.inputs .go:active,.staple button:active,.addex:active,.ef-save:active{transform:translateY(1px);}

  .card{background:var(--grad-card);border:1px solid rgba(60,100,150,.55);border-radius:18px;padding:18px;margin-top:14px;box-shadow:var(--shadow-card), var(--hi);}
  .card h2{font-family:'Jost',serif;font-size:23px;line-height:1.15;}
  .card .sub{color:var(--steel);font-size:13.5px;margin-top:7px;}
  .eyebrow{font-family:'Jost',monospace;font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:var(--flare);margin-bottom:5px;}

  /* ===== TRAIN ===== */
  .days{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:14px;}
  .day{background:var(--grad-tile);border:1px solid rgba(60,100,150,.5);border-radius:11px;padding:10px 3px;cursor:pointer;text-align:center;transition:.15s;box-shadow:var(--shadow-tile), var(--hi);}
  .day .n{font-family:'Jost',monospace;font-size:10px;color:var(--dim);letter-spacing:.1em;}
  .day .t{font-size:12px;font-weight:700;margin-top:2px;}
  .day.on{background:var(--flare);border-color:var(--flare);box-shadow:0 6px 16px -6px rgba(154,91,55,.5);}
  .day.on .t{color:#fff;}
  .day.on .n{color:rgba(255,255,255,.72);}

  .exs{margin-top:6px;}
  .ex{padding:15px 0;border-bottom:1px solid var(--edge);}
  .ex:last-child{border-bottom:none;}
  .ex .head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;}
  .ex .nm{font-size:15.5px;font-weight:700;}
  .ex .pres{font-family:'Jost',monospace;font-size:12px;color:var(--steel);white-space:nowrap;}
  .ex .cue{color:var(--dim);font-size:12.5px;margin-top:4px;}

  /* signature: the beat-it readout */
  .beat{display:flex;align-items:center;gap:10px;margin-top:10px;padding:9px 12px;border-radius:11px;
    background:var(--deck-2);border:1px solid var(--edge);}
  .beat .lab{font-family:'Jost',monospace;font-size:9.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);}
  .beat .val{font-family:'Jost',monospace;font-size:16px;font-weight:700;color:var(--steel);margin-left:auto;}
  .beat.fresh{border-color:var(--teal);background:rgba(154,91,55,0.10);}
  .beat.fresh .val{color:var(--teal);}
  .beat.empty .val{color:var(--dim);font-size:13px;}

  .logbtn{margin-top:9px;background:none;border:1px solid var(--edge);color:var(--flare);border-radius:10px;
    padding:7px 13px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:'Jost';transition:.15s;}
  .logbtn:hover{border-color:var(--flare);}
  .inputs.show{display:block;}
  .inputs .inrow{display:flex;gap:7px;align-items:center;}
  .vars{display:flex;gap:6px;margin-bottom:9px;flex-wrap:wrap;}
  .vchip{background:var(--void);border:1px solid var(--edge);color:var(--steel);border-radius:8px;
    padding:6px 12px;font-family:'Jost',monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;
    cursor:pointer;transition:.12s;}
  .vchip.on{background:var(--volt);border-color:var(--volt);color:#fff;font-weight:700;}
  .setrow .sv .tag{font-family:'Jost',monospace;font-size:10px;color:var(--volt);
    border:1px solid rgba(154,91,55,0.4);border-radius:4px;padding:1px 5px;letter-spacing:.06em;text-transform:uppercase;}

  .inputs{display:none;margin-top:9px;}
  .inputs input{flex:1;min-width:0;background:#F6EAED;border:1px solid var(--edge);color:var(--paper);
    border-radius:10px;padding:11px 4px;font-family:'Jost',monospace;font-size:15px;font-weight:700;text-align:center;box-shadow:var(--inset);}
  .inputs input:focus{outline:2px solid var(--flare);outline-offset:1px;}
  .inputs .x{color:var(--dim);font-family:'Jost';font-size:12px;}
  .inputs .go{background:linear-gradient(180deg,#A5683F,#8A5432);color:#fff;border:none;border-radius:10px;padding:11px 15px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Jost';box-shadow:0 4px 12px -3px rgba(154,91,55,.4), var(--hi);}
  .inputs .tmr{display:block;width:100%;margin-bottom:8px;background:var(--void);border:1px solid var(--volt);color:var(--volt);border-radius:10px;padding:13px;font-family:'Jost',monospace;font-size:16px;font-weight:700;cursor:pointer;transition:.12s;}
  .inputs .tmr.run{background:var(--volt);color:#fff;border-color:var(--volt);}

  .setlist{margin-top:9px;border-left:2px solid var(--flare);padding-left:11px;}
  .setrow{display:flex;align-items:center;gap:10px;padding:5px 0;}
  .setrow .sn{font-family:'Jost',monospace;font-size:10px;color:var(--dim);width:14px;}
  .setrow .sv{font-family:'Jost',monospace;font-size:13.5px;font-weight:700;}
  .setrow .sd{background:none;border:none;color:var(--dim);cursor:pointer;margin-left:auto;padding:2px 4px;font-size:12px;}
  .setrow .sd:hover{color:var(--flare);}

  .rulebox{margin-top:14px;padding:14px;border-radius:13px;background:rgba(154,91,55,0.07);border:1px solid rgba(154,91,55,0.28);font-size:13.5px;}
  .trainhead{display:flex;align-items:center;justify-content:space-between;}
  .editbtn{background:none;border:none;color:var(--dim);font-family:'Jost',monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:2px 4px;font-weight:700;transition:.15s;}
  .editbtn.on{color:var(--flare);}
  .day.dayadd{border-style:dashed;border-color:var(--flare);}
  .day.dayadd .t,.day.dayadd .n{color:var(--flare);}
  .daytools{display:flex;gap:8px;margin-top:10px;}
  .daytools input{flex:1;min-width:0;background:var(--void);border:1px solid var(--edge);color:var(--paper);border-radius:10px;padding:10px;font-family:'Jost';font-size:14px;}
  .daytools input:focus{outline:2px solid var(--flare);outline-offset:1px;}
  .daytools button{background:none;border:1px solid var(--edge);color:var(--steel);border-radius:10px;padding:0 14px;font-size:12.5px;font-weight:600;cursor:pointer;font-family:'Jost';}
  .daytools button:hover:not(:disabled){border-color:var(--flare);color:var(--flare);}
  .daytools button:disabled{opacity:.35;cursor:default;}
  .exedit{padding:12px 0;border-bottom:1px solid var(--edge);}
  .exedit:last-of-type{border-bottom:none;}
  .ee-view{display:flex;align-items:center;gap:10px;}
  .ee-main{flex:1;min-width:0;}
  .ee-main .nm{font-size:15px;font-weight:700;display:block;}
  .ee-main .pres{font-family:'Jost',monospace;font-size:11.5px;color:var(--steel);}
  .ee-ctrl{display:flex;gap:4px;flex-shrink:0;}
  .ee-ctrl button{background:var(--deck-2);border:1px solid var(--edge);color:var(--steel);border-radius:8px;width:30px;height:30px;cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center;padding:0;}
  .ee-ctrl button:hover:not(:disabled){border-color:var(--flare);color:var(--flare);}
  .ee-ctrl button:disabled{opacity:.3;cursor:default;}
  .ee-ctrl .del:hover{color:var(--flare);border-color:var(--flare);}
  .ee-form{display:none;flex-direction:column;gap:7px;margin-top:10px;}
  .ee-form.show{display:flex;}
  .ee-form.addform{display:none;} .ee-form.addform.show{display:flex;}
  .ee-form input,.ee-form textarea{background:var(--void);border:1px solid var(--edge);color:var(--paper);border-radius:10px;padding:10px 12px;font-family:'Jost';font-size:14px;}
  .ee-form textarea{resize:vertical;min-height:52px;}
  .ee-form input:focus,.ee-form textarea:focus{outline:2px solid var(--flare);outline-offset:1px;}
  .ee-form .ef-save{background:var(--flare);color:#fff;border:none;border-radius:10px;padding:11px;font-weight:700;cursor:pointer;font-family:'Jost';font-size:14px;}
  .addex{margin-top:14px;width:100%;background:none;border:1px dashed var(--flare);color:var(--flare);border-radius:12px;padding:12px;font-size:13.5px;font-weight:700;cursor:pointer;font-family:'Jost';}
  .bkrow{display:flex;flex-direction:column;gap:9px;margin-top:14px;}
  .bkbtn{width:100%;background:linear-gradient(180deg,#A5683F,#8A5432);color:#fff;border:none;border-radius:12px;padding:13px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Jost';box-shadow:0 4px 14px -3px rgba(154,91,55,.35), var(--hi);}
  .bkbtn.alt{background:none;border:1px solid var(--edge);color:var(--steel);}
  .bkbtn.alt:hover{border-color:var(--flare);color:var(--flare);}
  .bkbtn.warn{background:none;border:1px solid var(--flare);color:var(--flare);margin-top:9px;}
  .saved{font-size:12.5px;color:var(--volt);height:16px;margin-top:9px;opacity:0;transition:.3s;text-align:center;}
  .saved.show{opacity:1;}
  .bkimport{display:none;margin-top:12px;}
  .bkimport.show{display:block;}
  .bkimport textarea{width:100%;background:var(--void);border:1px solid var(--edge);color:var(--paper);border-radius:12px;padding:12px;font-family:'Jost',monospace;font-size:12px;resize:vertical;min-height:90px;}
  .bkimport textarea:focus{outline:2px solid var(--flare);outline-offset:1px;}
  #toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:var(--volt);color:#fff;
    font-family:'Jost';font-weight:700;font-size:13px;padding:9px 18px;border-radius:999px;opacity:0;pointer-events:none;
    transition:opacity .2s, transform .2s;z-index:50;box-shadow:0 6px 20px rgba(110,90,60,.35);}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .rulebox b{color:var(--flare);}

  /* ===== FUEL ===== */
  .targets{display:flex;gap:11px;margin-top:14px;}
  .tgt{flex:1;background:var(--grad-tile);border:1px solid rgba(60,100,150,.5);border-radius:14px;padding:14px;box-shadow:var(--shadow-tile), var(--hi);}
  .tgt .top{display:flex;justify-content:space-between;align-items:baseline;}
  .tgt .now{font-family:'Jost',monospace;font-size:25px;font-weight:700;line-height:1;}
  .tgt .of{font-family:'Jost',monospace;font-size:11px;color:var(--dim);}
  .tgt .lab{font-family:'Jost',monospace;font-size:9.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--steel);margin-top:7px;}
  .bar{height:7px;background:var(--void);border-radius:6px;margin-top:8px;overflow:hidden;}
  .bar i{display:block;height:100%;border-radius:6px;width:0;transition:width .45s cubic-bezier(.2,.8,.2,1);}
  .cal .now{color:var(--paper);} .cal .bar i{background:var(--paper);}
  .pro .now{color:var(--volt);} .pro .bar i{background:var(--volt);}
  /* goal hit: turn the tile gold and celebrate */
  .tgt.hit{border-color:rgba(154,91,55,.55);box-shadow:var(--shadow-tile), var(--hi), 0 0 0 1px rgba(154,91,55,.3), 0 6px 20px -4px rgba(154,91,55,.3);}
  .tgt.hit .now{color:var(--flare);}
  .tgt.hit .bar i{background:var(--flare);}
  .tgt.hit .lab::after{content:' ✓';color:var(--flare);font-weight:700;}
  @keyframes goalPop{0%{transform:scale(1);}35%{transform:scale(1.045);}100%{transform:scale(1);}}
  .tgt.pop{animation:goalPop .5s cubic-bezier(.34,1.56,.64,1);}
  @media (prefers-reduced-motion:reduce){.tgt.pop{animation:none;}}
  #celebrate{position:fixed;left:50%;bottom:70px;transform:translateX(-50%) translateY(20px);
    background:linear-gradient(180deg,#A5683F,#8A5432);color:#fff;font-family:'Jost',sans-serif;font-weight:700;font-size:14px;
    padding:11px 20px;border-radius:999px;opacity:0;pointer-events:none;transition:opacity .25s, transform .25s;z-index:60;
    box-shadow:0 8px 26px -4px rgba(154,91,55,.55);}
  #celebrate.show{opacity:1;transform:translateX(-50%) translateY(0);}

  .qhead{display:flex;align-items:center;justify-content:space-between;margin-top:18px;margin-bottom:6px;}
  .qhead .eyebrow{margin:0;}
  .editbtn{background:none;border:none;color:var(--dim);font-family:'Jost',monospace;font-size:10.5px;
    letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:2px 4px;transition:.15s;}
  .editbtn:hover{color:var(--steel);}
  .editbtn.on{color:var(--flare);}
  .quick{display:flex;flex-wrap:wrap;gap:6px;}
  .chip{background:var(--grad-tile);border:1px solid rgba(60,100,150,.55);color:var(--paper);border-radius:999px;
    padding:7px 12px;font-size:12px;cursor:pointer;transition:.15s;font-family:'Jost';box-shadow:var(--shadow-tile), var(--hi);}
  .chip:active{transform:translateY(1px);}
  .chip:hover{border-color:var(--volt);color:var(--volt);}
  .chip small{color:var(--dim);font-family:'Jost';font-size:10px;margin-left:4px;}
  .chip .del{color:var(--flare);margin-left:8px;font-family:'Jost';font-size:11px;}
  .chip.new{border-style:dashed;border-color:var(--flare);color:var(--flare);}
  .chip.new:hover{background:rgba(154,91,55,0.1);color:var(--flare);border-color:var(--flare);}
  .staple{display:none;gap:7px;margin-top:10px;}
  .staple.show{display:flex;}
  .staple input{background:var(--void);border:1px solid var(--edge);color:var(--paper);border-radius:11px;
    padding:11px;font-size:14px;font-family:'Jost';min-width:0;}
  .staple .sn{flex:2.2;}
  .staple .sc,.staple .sp{flex:1;text-align:center;font-family:'Jost';font-weight:700;}
  .staple input:focus{outline:2px solid var(--flare);outline-offset:1px;}
  .staple button{background:var(--flare);color:#fff;border:none;border-radius:11px;padding:0 16px;
    font-weight:700;cursor:pointer;font-family:'Jost';font-size:14px;}

  .addrow{display:flex;gap:7px;margin-top:12px;}
  .addrow input{background:#F6EAED;border:1px solid var(--edge);color:var(--paper);border-radius:11px;padding:11px;font-size:14px;font-family:'Jost';min-width:0;box-shadow:var(--inset);}
  .addrow .f{flex:2.2;}
  .addrow .c,.addrow .p{flex:1;text-align:center;font-family:'Jost';font-weight:700;}
  .addrow input:focus{outline:2px solid var(--flare);outline-offset:1px;}
  .addrow button{background:linear-gradient(180deg,#A5683F,#8A5432);color:#fff;border:none;border-radius:11px;padding:0 16px;font-weight:700;cursor:pointer;font-family:'Jost';font-size:14px;box-shadow:0 4px 12px -3px rgba(154,91,55,.4), var(--hi);}
  .addrow button:active{transform:translateY(1px);}

  .foods{margin-top:14px;}
  .food{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--edge);font-size:14px;}
  .food:last-child{border-bottom:none;}
  .food .n{flex:1;}
  .food .m{font-family:'Jost',monospace;font-size:12.5px;color:var(--steel);white-space:nowrap;}
  .food .m b{color:var(--volt);font-weight:700;}
  .food .rm{background:none;border:none;color:var(--dim);cursor:pointer;font-size:15px;padding:2px 5px;}
  .food .rm:hover{color:var(--flare);}
  .food .star{background:none;border:none;color:var(--dim);cursor:pointer;font-size:15px;padding:2px 4px;line-height:1;transition:.12s;}
  .food .star:hover{color:var(--flare);}
  .food .star.is{color:var(--flare);opacity:.5;cursor:default;}

  /* goal history heatmap */
  .goalsec{margin-top:24px;padding-top:20px;border-top:1px solid var(--edge);}
  .heat{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-top:14px;}
  #wdGrid{grid-template-columns:repeat(7,1fr);margin-top:6px;}
  #goals{grid-template-columns:repeat(7,1fr);margin-top:6px;}
