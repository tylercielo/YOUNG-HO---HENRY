function recentFoods(limit){
  limit=limit||8;
  const dates=Object.keys(S.food||{}).sort((a,b)=>b.localeCompare(a));
  const seen=new Set(), out=[];
  for(const d of dates){
    const list=S.food[d]||[];
    for(let i=list.length-1;i>=0;i--){
      const x=list[i]; if(!x||!x.n) continue;
      const key=x.n.toLowerCase();
      if(seen.has(key)) continue;
      seen.add(key); out.push({n:x.n,c:x.c||0,p:x.p||0});
      if(out.length>=limit) return out;
    }
  }
  return out;
}
