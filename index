function moveExercise(id,dir){
  const ex=dayObj().ex, i=ex.findIndex(e=>e.id===id), j=i+dir;
  if(i<0||j<0||j>=ex.length) return;
  [ex[i],ex[j]]=[ex[j],ex[i]]; save(); renderEx();
}
function removeExercise(id){
  const d=dayObj(); d.ex=d.ex.filter(e=>e.id!==id); save(); renderEx();
}
function editExercise(id,nm,pr,cue){
  const e=dayObj().ex.find(x=>x.id===id); if(!e) return;
  if(nm) e.nm=nm; e.pr=pr; e.cue=cue; save(); renderEx();
}
function addExercise(nm,pr,cue){
