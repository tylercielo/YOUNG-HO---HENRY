<script>
const KEY='henry';
const CAL=2300, PRO=175, GOAL=160, START=175;

let S={lifts:{},food:{},weights:[]};

/* ---- storage: works inside Claude and as a hosted page ---- */
async function load(){
  try{
    if(window.storage){ const r=await window.storage.get(KEY); if(r&&r.value) S=JSON.parse(r.value); }
    else { const v=localStorage.getItem(KEY); if(v) S=JSON.parse(v); }
  }catch(e){}
  S.lifts=S.lifts||{}; S.food=S.food||{}; S.weights=S.weights||[]; S.sessions=S.sessions||[]; S.active=S.active||{};
  // migrate old {sets:n, weight, reps} entries into per-set arrays
  S.sessions.forEach(s=>{
    (s.entries||[]).forEach(e=>{
      if(!Array.isArray(e.sets)){
        const n=Math.max(1, parseInt(e.sets)||1);
        e.sets=Array.from({length:n},()=>({w:e.weight,r:e.reps,at:e.at}));
        delete e.weight; delete e.reps; delete e.at;
      }
    });
  });
  if(!Array.isArray(S.quick)) S.quick=DEFAULT_QUICK.slice();
  S.foodMemory=S.foodMemory||{};
  Object.values(S.food||{}).forEach(list=>(list||[]).forEach(x=>{ if(x&&x.n) S.foodMemory[x.n.toLowerCase()]={n:x.n,c:x.c||0,p:x.p||0}; }));
  if(!Array.isArray(S.workouts)||!S.workouts.length) S.workouts=JSON.parse(JSON.stringify(DEFAULT_W));
  patchExerciseOptions();
  if(!S.workouts.find(d=>d.id===day)) day=S.workouts[0].id;
  boot();
}
// give built-in exercises options that were added after the user's data was first saved
function patchExerciseOptions(){}
async function save(){
  try{
    const j=JSON.stringify(S);
    if(window.storage) await window.storage.set(KEY,j);
    else localStorage.setItem(KEY,j);
    toast();
  }catch(e){}
}
let toastTimer;
function toast(){
  let t=document.getElementById('toast');
  if(!t){ t=document.createElement('div'); t.id='toast'; t.textContent='saved ✓'; document.body.appendChild(t); }
  t.classList.add('show'); clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),1100);
}
const tk=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};

/* ---- tabs ---- */
const TABS=[...document.querySelectorAll('.tab')];
const PANELS=document.getElementById('panels');
const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
let animating=false;
function setActiveTab(t){
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');
}
function selectTab(t, keepScroll){
  if(!t) return;
  setActiveTab(t);
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('on'));
  document.getElementById('p-'+t.dataset.p).classList.add('on');
  if(!keepScroll) window.scrollTo(0,0);
}
TABS.forEach(t=>t.addEventListener('click',()=>selectTab(t)));

/* goal celebration state */
let prevCalHit=false, prevProHit=false, fuelReady=false, celebTimer;
function bigToast(msg){
  let t=document.getElementById('celebrate');
  if(!t){ t=document.createElement('div'); t.id='celebrate'; document.body.appendChild(t); }
  t.textContent=msg; t.classList.add('show'); clearTimeout(celebTimer);
  celebTimer=setTimeout(()=>t.classList.remove('show'),1900);
}
function celebrateGoal(kind,tile){
  if(tile){ tile.classList.remove('pop'); void tile.offsetWidth; tile.classList.add('pop'); }
  bigToast(kind==='cal' ? 'Calories hit — huge 💪' : 'Protein locked in ✓');
}

/* count-up animation for changing numbers (calories / protein) */
function animateNumber(el,to,fmt){
  if(!el) return;
  fmt=fmt||String;
  const from=parseInt(String(el.dataset.v!==undefined?el.dataset.v:el.textContent).replace(/[^0-9.-]/g,''))||0;
  if(reduceMotion || from===to){ el.textContent=fmt(to); el.dataset.v=to; return; }
  el.dataset.v=to;
  const dur=450, t0=performance.now();
  (function step(t){
    const p=Math.min(1,(t-t0)/dur), e=1-Math.pow(1-p,3);
    el.textContent=fmt(Math.round(from+(to-from)*e));
    if(p<1) requestAnimationFrame(step);
  })(t0);
}

/* open-time nudge: surface the single most useful thing when you open the app */
let nudgeDismissed=false;
function computeNudge(){
  const dnum=iso=>{const[y,m,dd]=iso.split('-').map(Number);return Date.UTC(y,m-1,dd)/864e5;};
  const now=new Date(), todayNum=Date.UTC(now.getFullYear(),now.getMonth(),now.getDate())/864e5;
  const out=[];
  if((S.sessions||[]).length){
    const last=[...S.sessions].sort((a,b)=>b.date.localeCompare(a.date))[0];
    const gap=todayNum-dnum(last.date);
    if(gap>=3) out.push({p:3,t:`<b>${gap} days</b> since your last session — time to move.`});
  }
  // calories under target on recent completed days
  let under=0;
  for(let k=1;k<=4;k++){
    const d=new Date(now.getFullYear(),now.getMonth(),now.getDate()-k);
    const key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    const list=S.food[key]; if(list===undefined) break;
    const tc=(list||[]).reduce((a,b)=>a+(b.c||0),0);
    if(tc>0 && tc<CAL) under++; else break;
  }
  if(under>=3) out.push({p:2,t:`Calories under target <b>${under} days</b> running — eat for the build.`});
  if((S.weights||[]).length){
    const lw=[...S.weights].sort((a,b)=>b.date.localeCompare(a.date))[0];
    const gap=todayNum-dnum(lw.date);
    if(gap>=4) out.push({p:1,t:`Weigh-in's <b>${gap} days</b> overdue — the line needs data.`});
  }
  out.sort((a,b)=>b.p-a.p);
  return out.length?out[0].t:null;
}
