/* goal history: colour each of the last 30 days by whether it hit protein / calories */
function dayTotals(list){
  const tc=(list||[]).reduce((a,b)=>a+(b.c||0),0), tp=(list||[]).reduce((a,b)=>a+(b.p||0),0);
  return {tc,tp,cal:tc>=CAL,pro:tp>=PRO,logged:(list||[]).length>0};
}
function renderGoals(){
  const grid=document.getElementById('goals'); if(!grid) return;
  const todayKeyStr=tk();
  const now=new Date(); const today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
  const dow=today.getDay();
  const WEEKS=5;
  const start=new Date(today.getFullYear(),today.getMonth(),today.getDate()-dow-7*(WEEKS-1));
  const days=[];
  for(let i=0;i<WEEKS*7;i++){
    const d=new Date(start.getFullYear(),start.getMonth(),start.getDate()+i);
    const key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    const future=d>today;
    days.push({d,key,future,st:future?{}:dayTotals(S.food[key])});
  }
  const past=days.filter(x=>!x.future);
  const proDays=past.filter(x=>x.st.pro).length;
  const calDays=past.filter(x=>x.st.cal).length;
  const bothDays=past.filter(x=>x.st.pro&&x.st.cal).length;
  document.getElementById('goalStats').innerHTML=
    `<div class="st"><div class="v">${bothDays}</div><div class="l">both hit</div></div>`+
    `<div class="st"><div class="v">${proDays}</div><div class="l">protein days</div></div>`+
    `<div class="st"><div class="v">${calDays}</div><div class="l">calorie days</div></div>`;
  grid.innerHTML=days.map((x,i)=>{
    if(x.future) return `<button class="cell future" disabled></button>`;
    const cls = x.st.pro&&x.st.cal ? 'g-both' : (x.st.pro||x.st.cal ? 'g-part' : (x.st.logged ? 'g-miss':'g-none'));
    const t = x.key===todayKeyStr ? ' today' : '';
    return `<button class="cell ${cls}${t}" data-i="${i}"></button>`;
  }).join('');
  const detail=document.getElementById('goalDetail');
  grid.querySelectorAll('.cell:not(.future)').forEach(b=>b.addEventListener('click',()=>{
    const x=days[+b.dataset.i];
    const lbl=x.d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});
    if(!x.st.logged){ detail.innerHTML=`${lbl} · <span class="miss">nothing logged</span>`; return; }
    const pMark=x.st.pro?'✓':'✕', cMark=x.st.cal?'✓':'✕';
    detail.innerHTML=`${lbl} · ${x.st.tc.toLocaleString()} cal ${cMark} · <b>${x.st.tp}p ${pMark}</b>`;
  }));
}

