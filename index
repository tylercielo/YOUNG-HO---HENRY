function addSet(box){
  const wEl=box.querySelector('.w'), rEl=box.querySelector('.r');
  const wRaw=wEl.value.trim();
  const r=parseInt(rEl.value);
  if(!r){ rEl.focus(); return; }
  // blank weight = bodyweight; otherwise it has to be a real number
  const w = wRaw==='' ? 'BW' : parseFloat(wRaw);
  if(w!=='BW' && !(w>0)){ wEl.focus(); return; }
  const id=box.dataset.id;
  const ex=dayObj().ex.find(e=>e.id===id);
  const tag = ex&&ex.v ? (sel[id]||ex.v[0]) : null;
  recordSet(id,{w,r,t:tag,u: ex&&ex.timed?'s':null});
  save(); renderEx(); renderHistory();
  // reopen the same box, cleared, with the variation kept — cursor on weight for the next set
  const reopened=document.querySelector(`.inputs[data-id="${id}"]`);
  if(reopened){
    reopened.classList.add('show');
    if(tag) reopened.querySelectorAll(`.vchip[data-id="${id}"]`).forEach(x=>x.classList.toggle('on',x.dataset.v===tag));
    if(ex&&ex.timed){ const t=reopened.querySelector('.tmr'); if(t){ t.textContent='▶ Start'; t.classList.remove('run'); } }
    else reopened.querySelector('.w').focus();
  }
}

/* file one set into today's session, stamped with the device clock */
function recordSet(id,set){
  const d=tk(), key=todayKey();
  let s=S.sessions.find(x=>x.key===key);
  if(!s){ s={key,date:d,day,entries:[]}; S.sessions.push(s); }
  const ex=dayObj().ex.find(e=>e.id===id);
  let e=s.entries.find(x=>x.id===id);
  if(!e){ e={id,nm:ex?ex.nm:id,sets:[]}; s.entries.push(e); }
  e.sets.push({w:set.w,r:set.r,t:set.t||null,u:set.u||null,at:new Date().toISOString()});
}
function removeSet(id,i){
  const s=S.sessions.find(x=>x.key===todayKey());
  if(!s) return;
  const e=s.entries.find(x=>x.id===id);
  if(!e) return;
  e.sets.splice(i,1);
  if(!e.sets.length) s.entries=s.entries.filter(x=>x.id!==id);
  if(!s.entries.length) S.sessions=S.sessions.filter(x=>x.key!==s.key);
  save(); renderEx(); renderHistory();
}

