function logW(){
  const i=document.getElementById('wIn'); const v=parseFloat(i.value);
  if(!v||v<80||v>500){i.focus();return;}
  const d=tk(); const at=S.weights.findIndex(w=>w.date===d);
  if(at>=0) S.weights[at].weight=v; else S.weights.push({date:d,weight:v});
  S.weights.sort((a,b)=>a.date.localeCompare(b.date));
  i.value=''; save(); renderTrend();
}
const dn=iso=>{const[y,m,d]=iso.split('-').map(Number);return Date.UTC(y,m-1,d)/864e5;};
function trendPts(){
  return S.weights.map(w=>{
    const x=dn(w.date);
    const win=S.weights.filter(o=>{const d=dn(o.date);return d<=x&&d>x-7;});
    return {x, y:win.reduce((a,b)=>a+b.weight,0)/win.length};
  });
}
function renderTrend(){
  const n=S.weights.length;
  const tp=trendPts();
  const avg = n? tp[tp.length-1].y : null;
  document.getElementById('sNow').textContent = avg? avg.toFixed(1) : '–';
  document.getElementById('sGain').textContent = avg? (START-avg).toFixed(1) : '–';
  let rate='–';
  if(tp.length>1){
    const a=tp[0], b=tp[tp.length-1];
    const wk=(b.x-a.x)/7;
    if(wk>=1) rate=((b.y-a.y)/wk>=0?'+':'')+((b.y-a.y)/wk).toFixed(2);
    else rate='soon';
  }
  document.getElementById('sRate').textContent=rate;

  const c=document.getElementById('chart');
  if(!n){ c.innerHTML='<div class="empty">No weigh-ins yet.<br>The line needs about two weeks before it means anything.</div>'; renderHist(); return; }
  const Wd=520,H=238,pl=36,pr=16,pt=14,pb=34;
  const xs=S.weights.map(w=>dn(w.date));
  const firstX=Math.min(...xs), lastX=Math.max(...xs);
  const dataSpan=lastX-firstX;
  // window grows with your data but never crams the early dots: min ~8 days wide, with breathing room on both sides
  const windowDays=Math.max(dataSpan,8);
  const padL=Math.max(windowDays*0.06,0.5), padR=Math.max(windowDays*0.12,1.5);
  const minX=firstX-padL, maxX=firstX+windowDays+padR;
  const ys=S.weights.map(w=>w.weight).concat([GOAL,START]);
  const minY=Math.min(...ys)-2, maxY=Math.max(...ys)+2;
  const px=x=>pl+((x-minX)/(maxX-minX||1))*(Wd-pl-pr);
  const py=y=>pt+(1-(y-minY)/(maxY-minY||1))*(H-pt-pb);
  const dayToLabel=dnum=>new Date(dnum*864e5).toLocaleDateString(undefined,{month:'short',day:'numeric',timeZone:'UTC'});
  let g='';
  g+=`<line x1="${pl}" y1="${py(GOAL)}" x2="${Wd-pr}" y2="${py(GOAL)}" stroke="#6E5A3E" stroke-width="2" stroke-dasharray="5 5" opacity=".8"/>`;
  g+=`<text x="${Wd-pr}" y="${py(GOAL)-6}" fill="#6E5A3E" font-size="10.5" text-anchor="end" font-family="Jost">160</text>`;
  g+=`<line x1="${pl}" y1="${py(START)}" x2="${Wd-pr}" y2="${py(START)}" stroke="#D9D0BD" stroke-width="1" stroke-dasharray="2 4"/>`;
  for(let i=0;i<=3;i++){const v=minY+(maxY-minY)*i/3;g+=`<text x="${pl-7}" y="${py(v)+3.5}" fill="#8A8069" font-size="9.5" text-anchor="end" font-family="Jost">${v.toFixed(0)}</text>`;}
  // x-axis date labels: one per weigh-in when few, otherwise ~5 evenly spaced
  let ticks;
  if(S.weights.length<=6){ ticks=[...new Set(xs)]; }
  else { ticks=[]; for(let i=0;i<=4;i++) ticks.push(Math.round(firstX+(lastX-firstX)*i/4)); ticks=[...new Set(ticks)]; }
  ticks.forEach(t=>{ g+=`<text x="${px(t)}" y="${H-8}" fill="#8A8069" font-size="9" text-anchor="middle" font-family="Jost">${dayToLabel(t)}</text>`; });
  S.weights.forEach(w=>{g+=`<circle cx="${px(dn(w.date))}" cy="${py(w.weight)}" r="3" fill="#8A8069"/>`;});
  if(tp.length>1){
    g+=`<path d="${tp.map((p,i)=>(i?'L':'M')+px(p.x)+' '+py(p.y)).join(' ')}" fill="none" stroke="#9A5B37" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;
  }
  if(tp.length) g+=`<circle cx="${px(tp[tp.length-1].x)}" cy="${py(tp[tp.length-1].y)}" r="5" fill="#9A5B37" stroke="#FFFFFF" stroke-width="2"/>`;
  c.innerHTML=`<svg viewBox="0 0 ${Wd} ${H}" role="img" aria-label="weight trend">${g}</svg>`;
  renderHist();
}
