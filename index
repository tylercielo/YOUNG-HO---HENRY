// fallback: infer muscles from keywords in the exercise name when there's no exact map entry
function inferMuscles(nm){
  const s=(nm||'').toLowerCase();
  const any=(...w)=>w.some(x=>s.includes(x));
  const both=(a,b)=>s.includes(a)&&s.includes(b);
  if(any('front raise')||both('front','raise')) return {m:['frontDelts'],s:[]};
  if(any('rear delt','reverse fly','reverse pec','rear fly')||both('rear','delt')) return {m:['rearDelts'],s:[]};
  if(any('face pull')) return {m:['rearDelts'],s:['upperBack']};
  if(any('lateral raise','lat raise','side raise')||both('side','raise')) return {m:['sideDelts'],s:[]};
  if(any('shoulder press','overhead press','ohp','military press','arnold press')) return {m:['frontDelts'],s:['sideDelts','triceps']};
  if(any('shrug')) return {m:['upperBack'],s:[]};
  if(any('plank','dead bug','bird dog','pallof','crunch','sit-up','sit up','ab wheel','leg raise','knee raise','hollow','russian twist','woodchop','oblique')) return {m:['core'],s:[]};
  if(any('calf','calve')) return {m:['calves'],s:[]};
  if(any('leg curl','ham curl','hamstring curl','nordic')) return {m:['hams'],s:[]};
  if(any('leg extension','quad extension','knee extension')) return {m:['quads'],s:[]};
  if(any('hip thrust','glute bridge','kickback','abduction','abductor','frog pump','glute')) return {m:['glutes'],s:[]};
  if(any('rdl','romanian','deadlift','good morning','pull-through','pull through')) return {m:['hams'],s:['glutes']};
  if(any('squat','leg press','lunge','hack','step up','step-up','sissy')) return {m:['quads'],s:['glutes']};
  if(any('wrist','forearm','farmer')) return {m:['forearms'],s:[]};
  if(any('hammer curl')) return {m:['biceps'],s:['forearms']};
  if(s.includes('curl')) return {m:['biceps'],s:[]};
  if(any('tricep','pushdown','skull','dip')||both('overhead','extension')) return {m:['triceps'],s:[]};
  if(/\brows?\b/.test(s)) return {m:['upperBack'],s:['lats','biceps']};
  if(any('pulldown','pull-up','pullup','pull up','chin','pullover','lat prayer')) return {m:['lats'],s:['biceps','upperBack']};
  if(any('reverse pec','pec deck','chest press','bench','fly','flye')||both('incline','press')||s.includes('chest')) return {m:['chest'],s:['frontDelts','triceps']};
  return null;
}
function muscleVolume(days){
  days=days||7;
  const t=new Date(), cutoff=new Date(t.getFullYear(),t.getMonth(),t.getDate()-(days-1));
  const totals={}; Object.keys(MUSCLES).forEach(k=>totals[k]=0);
  let untagged=0;
  (S.sessions||[]).forEach(s=>{
    const [y,m,d]=s.date.split('-').map(Number);
    if(new Date(y,m-1,d)<cutoff) return;
    (s.entries||[]).forEach(e=>{
      const sets=e.sets||[]; if(!sets.length) return;
      const tag=EX_MUSCLES[(e.nm||'').trim().toLowerCase()] || inferMuscles(e.nm);
      if(!tag){ untagged+=sets.length; return; }
      // a single-side (Left/Right) set works one limb → counts as half a muscle set
      let w=0; sets.forEach(st=>{ w += (st.t==='Left'||st.t==='Right') ? 0.5 : 1; });
      (tag.m||[]).forEach(k=>{ if(k in totals) totals[k]+=w; });
      (tag.s||[]).forEach(k=>{ if(k in totals) totals[k]+=w*0.5; });
    });
  });
  return {totals,untagged};
}
function renderMuscles(){
  const el=document.getElementById('muscleBars'); if(!el) return;
  const {totals,untagged}=muscleVolume(7);
  const rows=Object.keys(MUSCLES).map(k=>({label:MUSCLES[k],v:totals[k]||0})).sort((a,b)=>b.v-a.v);
  const max=Math.max(12,...rows.map(r=>r.v));
  const LOW=6;
  el.innerHTML=rows.map(r=>{
    const cls = r.v===0?'zero':(r.v<LOW?'low':'');
    const w=Math.min(100,r.v/max*100);
    const val=Number.isInteger(r.v)?r.v:r.v.toFixed(1);
    return `<div class="mrow ${cls}"><span class="mn">${r.label}</span><span class="mbar"><i style="width:${w}%"></i></span><span class="mv">${val}</span></div>`;
  }).join('');
  const note=document.getElementById('muscleNote'); if(!note) return;
  const lows=rows.filter(r=>r.v<LOW).map(r=>r.label);
  let txt = lows.length ? `<span class="miss">Low this week:</span> ${lows.join(', ')}` : `Every group has volume this week. Balanced.`;
  if(untagged) txt += ` <span class="miss">· ${untagged} set${untagged===1?'':'s'} from unmapped lifts not counted</span>`;
  note.innerHTML=txt;
  renderGaps(totals);
}
// worst-first hit list: the most-neglected muscles + which of your lifts hit them
function renderGaps(totals){
  const box=document.getElementById('muscleGaps'); if(!box) return;
  const COVERED=8;
  const low=Object.keys(MUSCLES).map(k=>({k,label:MUSCLES[k],v:totals[k]||0}))
    .filter(m=>m.v<COVERED).sort((a,b)=>a.v-b.v).slice(0,6);
  // map each muscle to lifts you actually have that primarily train it
  const byMuscle={}, seen=new Set();
  (S.workouts||[]).forEach(d=>(d.ex||[]).forEach(e=>{
    const nm=(e.nm||'').trim(), key=nm.toLowerCase();
    if(!nm || seen.has(key)) return; seen.add(key);
    const tag=EX_MUSCLES[key] || inferMuscles(nm); if(!tag) return;
    (tag.m||[]).forEach(mk=>{ (byMuscle[mk]=byMuscle[mk]||[]).push(nm); });
  }));
  if(!low.length){ box.innerHTML=`<div class="gaps"><div class="gdone">Everything's covered this week — no gaps to chase. Hold your split.</div></div>`; return; }
  const rows=low.map((m,i)=>{
    const lifts=(byMuscle[m.k]||[]).slice(0,3);
    const ex = lifts.length
      ? lifts.map(nm=>`<a class="glink" data-nm="${nm.replace(/"/g,'&quot;')}">${nm}</a>`).join(' · ')
      : 'no lift mapped for this yet';
    const val=Number.isInteger(m.v)?m.v:m.v.toFixed(1);
    return `<div class="gaprow"><span class="gi">${i+1}</span><div class="gbody"><div class="gm">${m.label}<span class="gv">${val} set${m.v===1?'':'s'}</span></div><div class="gx">${ex}</div></div></div>`;
  }).join('');
  box.innerHTML=`<div class="gaps"><div class="gh">Fill the gaps · worst first · tap a lift to jump to it</div>${rows}</div>`;
  box.querySelectorAll('.glink').forEach(a=>a.addEventListener('click',()=>goToExercise(a.dataset.nm)));
}
// jump from a gap suggestion straight to that exercise on the Train tab
function goToExercise(nm){
  const key=(nm||'').trim().toLowerCase();
  let foundDay=null, foundId=null;
  for(const d of (S.workouts||[])){
    const e=(d.ex||[]).find(x=>(x.nm||'').trim().toLowerCase()===key);
    if(e){ foundDay=d.id; foundId=e.id; break; }
  }
  if(!foundDay) return;
  day=foundDay;
  renderDays(); renderEx();
  selectTab(TABS[0], true); // Train, keep scroll — we'll scroll to the exercise ourselves
  requestAnimationFrame(()=>{
    const elx=document.querySelector(`.ex[data-ex="${foundId}"]`);
    if(elx){
      elx.scrollIntoView({behavior:'smooth', block:'center'});
      elx.classList.remove('flash'); void elx.offsetWidth; elx.classList.add('flash');
    }
  });
}

/* colour each workout type distinctly on the day map */
const DAY_COLORS={push:'#A05A38', pull:'#6E7A5A', legs:'#8A7B5A', full:'#B08A4A', core:'#96625A'};
const DAY_FALLBACK=['#F5B78C','#B7A8F0','#7FD8C8','#F09CC0','#C7D66E'];
function dayColor(id){
  if(DAY_COLORS[id]) return DAY_COLORS[id];
  if(!id) return '#c9d6e8';
  // stable colour for any custom day id
  let h=0; for(let i=0;i<id.length;i++) h=(h*31+id.charCodeAt(i))>>>0;
  return DAY_FALLBACK[h%DAY_FALLBACK.length];
}
function renderWorkoutDays(){
  const grid=document.getElementById('wdGrid'); if(!grid) return;
  const todayStr=tk();
  const now=new Date(); const today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
  const dow=today.getDay(); // 0=Sun … aligns columns to the weekday
  const WEEKS=5;
  const start=new Date(today.getFullYear(),today.getMonth(),today.getDate()-dow-7*(WEEKS-1));
  const cells=[];
  for(let i=0;i<WEEKS*7;i++){
    const d=new Date(start.getFullYear(),start.getMonth(),start.getDate()+i);
    const key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    const future=d>today;
    const sess=future?[]:(S.sessions||[]).filter(s=>s.date===key);
    const active=future?false:((S.active||{})[key]!==undefined);
    cells.push({d,key,future,sess,active,trained:sess.length>0});
  }
  const past=cells.filter(c=>!c.future);
  const trained=past.filter(c=>c.trained).length;
  const activeDays=past.filter(c=>c.active&&!c.trained).length;
  const perWeek=(trained/(past.length/7)).toFixed(1);
  document.getElementById('wdStats').innerHTML=
    `<div class="st"><div class="v">${trained}</div><div class="l">lift days</div></div>`+
    `<div class="st"><div class="v">${activeDays}</div><div class="l">active days</div></div>`+
    `<div class="st"><div class="v">${perWeek}</div><div class="l">lifts / week</div></div>`;
  grid.innerHTML=cells.map((x,i)=>{
    if(x.future) return `<button class="cell future" disabled></button>`;
    const t = x.key===todayStr ? ' today' : '';
    if(x.trained){
      const col=dayColor(x.sess[0]&&x.sess[0].day);
      return `<button class="cell${t}" style="background:${col};border-color:${col};" data-i="${i}"></button>`;
    }
    const cls = x.active ? 'g-cardio' : 'g-none';
    return `<button class="cell ${cls}${t}" data-i="${i}"></button>`;
  }).join('');
  const leg=document.getElementById('wdLegend');
  if(leg){
    leg.innerHTML = (S.workouts||[]).map(w=>`<span><i class="sw" style="background:${dayColor(w.id)}"></i>${w.label}</span>`).join('')
      + `<span><i class="sw g-cardio"></i>cardio</span><span><i class="sw g-none"></i>rest</span>`;
  }
  const detail=document.getElementById('wdDetail');
  grid.querySelectorAll('.cell:not(.future)').forEach(b=>b.addEventListener('click',()=>{
    const x=cells[+b.dataset.i];
    const lbl=x.d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});
    if(!x.trained){
      if(x.active){ const n=(S.active||{})[x.key]; detail.innerHTML=`${lbl} · <b>Active</b>${n?' · '+n:''}`; }
      else detail.innerHTML=`${lbl} · <span class="miss">rest / off</span>`;
      return;
    }
    const labels=[...new Set(x.sess.map(s=>(S.workouts.find(w=>w.id===s.day)||{}).label||s.day))].join(' + ');
    const sets=x.sess.reduce((a,s)=>a+(s.entries||[]).reduce((b,e)=>b+(e.sets?e.sets.length:0),0),0);
    const extra = x.active ? ` <span class="miss">+ cardio</span>` : '';
    detail.innerHTML=`${lbl} · <b>${labels}</b> · ${sets} set${sets===1?'':'s'}${extra}`;
  }));
}

/* active / cardio day marker (non-lifting days) */
function initActive(){
  const btn=document.getElementById('actAdd'), inp=document.getElementById('actNote');
  if(!btn) return;
  const logIt=()=>{ S.active=S.active||{}; S.active[tk()]=(inp.value||'').trim(); save(); renderActive(); renderWorkoutDays(); };
  btn.addEventListener('click',logIt);
  inp.addEventListener('keydown',e=>{ if(e.key==='Enter') logIt(); });
}
function renderActive(){
  const box=document.getElementById('actToday'); if(!box) return;
  const key=tk(), note=(S.active||{})[key];
  if(note===undefined){ box.innerHTML=''; return; }
  const shown=(note||'').replace(/</g,'&lt;');
  box.innerHTML=`<span class="acttag">✓ Logged active today${shown?' · '+shown:''}</span><button id="actDel">remove</button>`;
  document.getElementById('actDel').addEventListener('click',()=>{
    delete S.active[key];
    const inp=document.getElementById('actNote'); if(inp) inp.value='';
    save(); renderActive(); renderWorkoutDays();
  });
}

function tickClock(){
  const n=new Date();
  document.getElementById('clock').textContent =
    n.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}) + ' · ' +
    n.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});
}
setInterval(tickClock,30000);

/* ===== BACKUP / RESTORE ===== */
function flashMsg(txt){ const m=document.getElementById('bkMsg'); m.textContent=txt; m.classList.add('show'); setTimeout(()=>m.classList.remove('show'),2200); }
function initBackup(){
  document.getElementById('bkExport').addEventListener('click',async()=>{
    const code='HENRY1:'+btoa(unescape(encodeURIComponent(JSON.stringify(S))));
    let copied=false;
    try{ await navigator.clipboard.writeText(code); copied=true; }catch(e){}
    if(!copied){
      // fallback: drop it in the import box so it can be selected/copied manually
      const t=document.getElementById('bkText'); document.getElementById('bkImport').classList.add('show'); t.value=code; t.focus(); t.select();
      flashMsg('Copy the code shown below ↓');
    } else flashMsg('Backup copied ✓ — paste it somewhere safe');
  });
  document.getElementById('bkImportToggle').addEventListener('click',()=>{
    document.getElementById('bkImport').classList.toggle('show');
    if(document.getElementById('bkImport').classList.contains('show')) document.getElementById('bkText').focus();
  });
  document.getElementById('bkRestore').addEventListener('click',()=>{
    let raw=document.getElementById('bkText').value.trim();
    if(!raw){ flashMsg('Paste a backup code first'); return; }
    try{
      // strip the prefix regardless of case/spacing, and remove any stray whitespace/newlines
      raw=raw.replace(/^\s*henry1\s*:\s*/i,'').replace(/\s+/g,'');
      const data=JSON.parse(decodeURIComponent(escape(atob(raw))));
      if(typeof data!=='object'||!data) throw new Error('bad');
      S=data;
      S.food=S.food||{}; S.weights=S.weights||[]; S.sessions=S.sessions||[]; S.active=S.active||{};
      if(!Array.isArray(S.quick)) S.quick=DEFAULT_QUICK.slice();
      if(!Array.isArray(S.workouts)||!S.workouts.length) S.workouts=JSON.parse(JSON.stringify(DEFAULT_W));
      patchExerciseOptions();
      if(!S.workouts.find(d=>d.id===day)) day=S.workouts[0].id;
      save();
      renderDays(); renderEx(); renderQuick(); renderFuel(); renderTrend(); renderHistory(); renderActive();
      document.getElementById('bkText').value=''; document.getElementById('bkImport').classList.remove('show');
      flashMsg('Restored ✓ — all your data is back');
    }catch(e){ flashMsg('That code didn\'t read right — check you pasted all of it'); }
  });
}

function boot(){ initEditToggle(); initBackup(); initActive(); tickClock(); renderDays(); renderEx(); renderQuick(); renderFuel(); refreshFoodList(); renderTrend(); renderHistory(); renderActive(); renderNudge(); }
load();
</script>
